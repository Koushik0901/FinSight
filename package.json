{
  "name": "finsight",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --filter ui dev",
    "build": "pnpm --filter ui build",
    "test": "pnpm --filter ui test && cargo test --workspace",
    "typecheck": "pnpm --filter ui typecheck",
    "lint": "pnpm --filter ui lint && cargo clippy --workspace --all-targets -- -D warnings",
    "bindings": "cargo run -p finsight-bindings --bin export_bindings",
    "openapi": "cargo run -p finsight-openapi --bin export_openapi && pnpm --filter ui openapi:gen"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "3.4.13",
      "mermaid": "11.16.1"
    }
  },
  "packageManager": "pnpm@9.0.0"
}
