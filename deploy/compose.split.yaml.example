# Example split deployment: `api` + `web` (nginx) — the seam for a future
# multi-service FinSight without changing the TypeScript client.
#
# Usage:
#   docker compose -f docker-compose.yml -f deploy/compose.split.yaml.example up --build -d
#
# The default `docker-compose.yml` stays single-container (`finsight:8674` serves
# both API and `ui/dist`). This file demonstrates how to run the same image as
# a pure API (`FINSIGHT_UI_DIR=""` disables static serving) fronted by nginx
# (like Cookfully's `deploy/docker/nginx.conf`). The client still talks to
# `/api/*` — no URL change.
#
# Copy to `deploy/compose.split.yaml` and adjust ports if you want to run it.

services:
  api:
    image: ${FINSIGHT_IMAGE:-ghcr.io/koushik0901/finsight:latest}
    pull_policy: always
    restart: unless-stopped
    init: true
    read_only: true
    tmpfs:
      - /tmp:size=64m,mode=1777
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    expose:
      - "8674"
    volumes:
      - finsight-data:/data
    environment:
      FINSIGHT_DATA_DIR: /data
      # Empty UI dir disables static file serving — nginx serves the SPA instead
      FINSIGHT_UI_DIR: ""
      FINSIGHT_PORT: "8674"
      FINSIGHT_COOKIE_SECURE: "${FINSIGHT_COOKIE_SECURE:-1}"
      FINSIGHT_PUBLIC_ORIGIN: "${FINSIGHT_PUBLIC_ORIGIN:-}"
      RUST_LOG: info

  web:
    image: nginx:1.29-alpine
    restart: unless-stopped
    depends_on:
      api:
        condition: service_started
    ports:
      - "${FINSIGHT_HOST_PORT:-8080}:8080"
    volumes:
      - ./deploy/docker/nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - ./ui/dist:/usr/share/nginx/html:ro
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://127.0.0.1:8080/"]
      interval: 10s
      timeout: 5s
      retries: 12

volumes:
  finsight-data:
