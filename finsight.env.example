# Copy this file to .env beside docker-compose.yml, then uncomment only the
# settings you need. Release downloads pin FINSIGHT_IMAGE to that release.

# FINSIGHT_IMAGE=ghcr.io/koushik0901/finsight:latest
# FINSIGHT_HOST_PORT=8674
# FINSIGHT_COOKIE_SECURE=1
# FINSIGHT_PUBLIC_ORIGIN=https://finsight.example.com
